# ── Payment identity ────────────────────────────────────────────────────
PAY_TO=0x65bb932d9987f1d1a98b8942a3fa98cb28ec073b        # X Layer / EVM payout address

# ── OKX dev-portal (data API + X Layer x402 facilitator) — never commit real values ──
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ── Base rail (optional 2nd x402 rail: USDC on Base via Coinbase CDP) ─────
# Leave CDP keys empty to run X-Layer-only. Base is advertised only when it can actually settle
# (fail-safe), so a half-config never 402s a payer who already signed.
BASE_PAY_TO=0x65bb932d9987f1d1a98b8942a3fa98cb28ec073b
BASE_NETWORK=eip155:8453
BASE_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913     # USDC on Base
BASE_FACILITATOR_AUTH=cdp
CDP_API_KEY_ID=              # Coinbase CDP API key id     — never commit real values
CDP_API_KEY_SECRET=          # Coinbase CDP API secret     — never commit real values

# ── Proof signing (T1) — secp256k1 private key; the signer ADDRESS is published ──
QUIVER_SIGNING_KEY=          # 0x… private key             — never commit real values
EAS_CHAIN_ID=8453            # Base, for the EAS-ready attestation domain

# ── Diagnostics gate (protects the /diag/* routes) ───────────────────────
DIAG_TOKEN=                  # a random token              — never commit the real value

# ── Durable proof store (Phase A) — OFF unless one of these is set ───────
# Unset means proofs live in memory and a redeploy clears them, which is what /build reports today.
# Set the BUCKET for a store every replica shares; set the DIR for one that only this container sees.
# If both are set the bucket wins. Nothing else changes: no endpoint, no schema, no price.
QUIVER_PROOF_S3_BUCKET=      # e.g. quiver-proofs — turns the S3 backend on
QUIVER_PROOF_S3_REGION=      # defaults to AWS_REGION, then us-east-1
QUIVER_PROOF_S3_PREFIX=      # defaults to proofs/ — a trailing slash is added if you leave it off
QUIVER_PROOF_S3_ENDPOINT=    # only for a non-AWS S3 (MinIO, R2, Railway Buckets); blank = real AWS
# Credentials come from the AWS SDK's own chain — AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a shared
# profile, or (best) an IAM role with no static secret at all. Quiver defines no key variables of its
# own, on purpose: inventing them would force an operator to keep a long-lived key.
# The policy needs s3:PutObject, s3:GetObject, s3:DeleteObject and s3:ListBucket on the prefix.
# QUIVER_PROOF_DIR=          # a directory instead — survives a restart, NOT a second replica
# QUIVER_PROOF_MAX=500       # how many proofs to keep, oldest evicted first

# ── Runtime ──────────────────────────────────────────────────────────────
DATA_ADAPTER=auto            # rest | cli | auto
DEV_MODE=                    # local dev only — never set in production
# PORT=8080
# Per-service prices (PRICE_PERP_GATE, PRICE_PORTFOLIO_GATE, PRICE_OPTIONS_RISK, …) all have
# sensible defaults in src/config.js — override only if you want different pricing.
