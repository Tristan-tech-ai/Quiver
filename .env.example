# ── Payment identity ────────────────────────────────────────────────────
PAY_TO=0x65bb932d9987f1d1a98b8942a3fa98cb28ec073b        # X Layer / EVM payout address

# ── OKX dev-portal (data API + X Layer x402 facilitator) — never commit real values ──
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ── Base rail (optional 2nd x402 rail: USDC on Base via Coinbase CDP) ─────
# Leave CDP keys empty to run X-Layer-only. Base is advertised only when it can actually settle
# (fail-safe), so a half-config never 402s a payer who already signed.
BASE_PAY_TO=0x65bb932d9987f1d1a98b8942a3fa98cb28ec073b
BASE_NETWORK=eip155:8453
BASE_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913     # USDC on Base
BASE_FACILITATOR_AUTH=cdp
CDP_API_KEY_ID=              # Coinbase CDP API key id     — never commit real values
CDP_API_KEY_SECRET=          # Coinbase CDP API secret     — never commit real values

# ── Proof signing (T1) — secp256k1 private key; the signer ADDRESS is published ──
QUIVER_SIGNING_KEY=          # 0x… private key             — never commit real values
EAS_CHAIN_ID=8453            # Base, for the EAS-ready attestation domain

# ── Diagnostics gate (protects the /diag/* routes) ───────────────────────
DIAG_TOKEN=                  # a random token              — never commit the real value

# ── Runtime ──────────────────────────────────────────────────────────────
DATA_ADAPTER=auto            # rest | cli | auto
DEV_MODE=                    # local dev only — never set in production
# PORT=8080
# Per-service prices (PRICE_PERP_GATE, PRICE_PORTFOLIO_GATE, PRICE_OPTIONS_RISK, …) all have
# sensible defaults in src/config.js — override only if you want different pricing.
