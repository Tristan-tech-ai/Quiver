    mx[2].c[14] <== 16773632;
    mx[2].c[15] <== 16773376;
    mx[2].s[0] <== wbits.out[8];
    mx[2].s[1] <== wbits.out[9];
    mx[2].s[2] <== wbits.out[10];
    mx[2].s[3] <== wbits.out[11];
