    mx[1].c[8] <== 16777088;
    mx[1].c[9] <== 16777072;
    mx[1].c[10] <== 16777056;
    mx[1].c[11] <== 16777040;
    mx[1].c[12] <== 16777024;
    mx[1].c[13] <== 16777008;
    mx[1].c[14] <== 16776992;
