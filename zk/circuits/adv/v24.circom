    mx[1].s[0] <== wbits.out[4];
    mx[1].s[1] <== wbits.out[5];
    mx[1].s[2] <== wbits.out[6];
    mx[1].s[3] <== wbits.out[7];
    em[1] = MulShift(S);   em[1].a <== acc[1];   em[1].b <== mx[1].out;   acc[2] <== em[1].out;
    mx[2] = Mux4();
    mx[2].c[0] <== 16777216;
    mx[2].c[1] <== 16776960;
    mx[2].c[2] <== 16776704;
    mx[2].c[3] <== 16776448;
    mx[2].c[4] <== 16776192;
    mx[2].c[5] <== 16775936;
    mx[2].c[6] <== 16775680;
    mx[2].c[7] <== 16775424;
    mx[2].c[8] <== 16775168;
    mx[2].c[9] <== 16774912;
    mx[2].c[10] <== 16774656;
