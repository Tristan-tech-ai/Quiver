    mx[0].c[2] <== 16777214;
    mx[0].c[3] <== 16777213;
    mx[0].c[4] <== 16777212;
    mx[0].c[5] <== 16777211;
    mx[0].c[6] <== 16777210;
    mx[0].c[7] <== 16777209;
    mx[0].c[8] <== 16777208;
    mx[0].c[9] <== 16777207;
    mx[0].c[10] <== 16777206;
    mx[0].c[11] <== 16777205;
    mx[0].c[12] <== 16777204;
    mx[0].c[13] <== 16777203;
    mx[0].c[14] <== 16777202;
    mx[0].c[15] <== 16777201;
    mx[0].s[0] <== wbits.out[0];
    mx[0].s[1] <== wbits.out[1];
    mx[0].s[2] <== wbits.out[2];
    mx[0].s[3] <== wbits.out[3];
    em[0] = MulShift(S);   em[0].a <== acc[0];   em[0].b <== mx[0].out;   acc[1] <== em[0].out;
    mx[1] = Mux4();
    mx[1].c[0] <== 16777216;
    mx[1].c[1] <== 16777200;
    mx[1].c[2] <== 16777184;
    mx[1].c[3] <== 16777168;
    mx[1].c[4] <== 16777152;
    mx[1].c[5] <== 16777136;
