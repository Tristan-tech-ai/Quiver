    signal dh[8];
    dh[0] <== 1482910;
    dm[0] = MulShift(S);   dm[0].a <== dh[0];   dm[0].b <== zc;   dh[1] <== dm[0].out + 29455207;
    dm[1] = MulShift(S);   dm[1].a <== dh[1];   dm[1].b <== zc;   dh[2] <== dm[1].out + 269512177;
    dm[2] = MulShift(S);   dm[2].a <== dh[2];   dm[2].b <== zc;   dh[3] <== dm[2].out + 1455939089;
    dm[3] = MulShift(S);   dm[3].a <== dh[3];   dm[3].b <== zc;   dh[4] <== dm[3].out + 4975522460;
    dm[4] = MulShift(S);   dm[4].a <== dh[4];   dm[4].b <== zc;   dh[5] <== dm[4].out + 10692684031;
    dm[5] = MulShift(S);   dm[5].a <== dh[5];   dm[5].b <== zc;   dh[6] <== dm[5].out + 13318198867;
    dm[6] = MulShift(S);   dm[6].a <== dh[6];   dm[6].b <== zc;   dh[7] <== dm[6].out + 7388916375;
    signal bHat;  signal dHat;
    bHat <== bh[6];
    dHat <== dh[7];

    // ---- c, the upper tail, and its relation to n -----------------------------------------
    // Hart returns the UPPER tail c and the CDF is c for x <= 0 and 1 - c for x > 0. Written as
    // one quadratic rather than a branch, since a circuit has no branches.
    signal cHat;
    cHat <== ONE - nHat + xSign * (2 * nHat - ONE);
    // c is an upper tail at |x| >= 0, so it never exceeds a half. Cheap, and it stops a prover
    // handing in the complement and letting the sign bit absorb it.
    component cLe = LessEqThan(S + 2);  cLe.in[0] <== cHat;  cLe.in[1] <== ONE \ 2;  cLe.out === 1;

    // c*d = e*b, which is the division without dividing. An absolute error of T ulp in c shows up
    // here as T*dHat, so the tolerance is TOLC*dHat and TOLC reads directly in ulp.
    // TOLC = 12, DERIVED in probe-ncdf-tol.mjs and not chosen: 19 ulp of accumulated exp error
    // times b/d <= 0.5, plus 3.4e-3 from b, 1.7e-3 from d, plus 1.0023 for this relation's own
    // floor remainder = 10.507 ulp worst, at z = 0. The real engine's worst leg uses 18.3% of it,
    // and gateB7-5 shows a value 13 ulp out IS refused — otherwise it is not a bound.
    signal lhs;   lhs <== cHat * dHat;
    signal eb;    eb  <== eHat * bHat;
    signal resid; resid <== computed * (lhs - eb);
    signal tolC;  tolC <== TOLC * dHat;
    signal cShift; cShift <== 2 * resid + tolC;
    // NO separate Num2Bits on cShift. LessEqThan(n) already decomposes in[0] + 2^n - in[1] into
    // n+1 bits, so a cShift that is out of range — including a field-wrapped negative one — makes
    // that decomposition unsatisfiable and the prover cannot produce a witness at all. The extra
    // check the sibling circuits carry can only turn an accept into a refusal, never the reverse,
    // and it costs NB_R constraints. gateB7-5 confirms the refusal by hand rather than trusting
    // this paragraph.
    component cOk = LessEqThan(NB_R); cOk.in[0] <== cShift; cOk.in[1] <== 2 * tolC; cOk.out === 1;

    // ---- the density, which the CDF has already computed ----------------------------------
    // phi(x) = e^{-x^2/2}/sqrt(2*pi), and e^{-x^2/2} is `eHat`, the exp intermediate above. So the
    // density costs one multiply. This matters more than it looks: df*phi(d1) is the factor that
    // CANCELS between any two greeks, which is what let the consistency identities exist without a
    // transcendental. Pinning it is what stops it cancelling.
    signal pd;    pd <== pHat * SQRT2PI;
    signal pe;    pe <== eHat * ONE;
    signal presid; presid <== computed * (pd - pe);
    signal tolP;  tolP <== TOLP * SQRT2PI;
    signal pShift; pShift <== 2 * presid + tolP;
    component pOk = LessEqThan(NB_P); pOk.in[0] <== pShift; pOk.in[1] <== 2 * tolP; pOk.out === 1;

    // ---- above the split, the bound ------------------------------------------------------
    // Both functions are decreasing on the tail, so their value AT the split is the maximum over
    // it. gateB7-5 measures the true maximum and refuses if either constant is under it.
    signal tailc;  tailc <== (1 - computed) * cHat;
    component tcOk = LessEqThan(S + 2); tcOk.in[0] <== tailc; tcOk.in[1] <== CDF_TAIL; tcOk.out === 1;
    signal tailp;  tailp <== (1 - computed) * pHat;
    component tpOk = LessEqThan(S + 2); tpOk.in[0] <== tailp; tpOk.in[1] <== PHI_TAIL; tpOk.out === 1;
}

component main {public [xSign, xMag, nHat, pHat]} = NormalCdf();
