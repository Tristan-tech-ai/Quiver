pragma circom 2.1.6;

// GENERATED by zk/scripts/gen-ncdf-circom.mjs — do not hand-edit. Regenerate and re-gate.
//
// THE STANDARD NORMAL CDF, COMPUTED IN A CIRCUIT.
//
// The roadmap said options-risk "requires exp and erf in-circuit, which is where this stops being
// arithmetic and starts being a research project", and greeksfp/greekssigned/parity were built to
// route around it by proving CONSISTENCY identities that cancel the transcendental instead of
// evaluating it. probe-cdf-residue.mjs measured the cost of that route: a service using
// Abramowitz-Stegun 7.1.26 instead of Hart satisfies ALL EIGHT identities to 3.3e-14 and prices a
// leg 19.4% wrong. So the identities are blind to the thing that matters, and put-call parity is
// blind too — the put is P = df*(K*N(-d2) - F*N(-d1)), so any N with N(-x) = 1 - N(x) makes
// C - P = df*(F - K) hold ALGEBRAICALLY with N cancelling.
//
// The premise was wrong, in the same way the Tier-3 premise was wrong. "erf" is not what the
// engine computes. The engine computes HART (1968):
//
//     N(-z) = e^{-z^2/2} * b(z) / d(z)        for 0 <= z < 7.0711
//
// A ratio is a multiplication: c*d = e*b. A polynomial is Horner. That leaves one transcendental,
// e^{-w} — and e^{-w} FACTORS over the binary expansion of w in a way erf does not:
//
//     w = sum_i b_i 2^i    =>    e^{-w} = prod_i (e^{-2^i})^{b_i}
//
// Every factor is a constant and every choice is a multiplexer, so exp is a product of selected
// constants — which is what a circuit does natively. The wall was never the transcendental. It was
// the fixed-point representation, exactly as it was for Tier 3.
//
// ── WHAT IS PROVEN ──
//   for the public point x, the public value n is the normal CDF at x, and the public value p is
//   its density, both evaluated by the recurrences below. The evaluator is pinned, not asserted:
//   every multiply carries a range-checked remainder, so the prover cannot choose a rounding.
//
// ── WHAT IS NOT ──
//   this pins n GIVEN x. It does not pin x. For options-risk, x is d1 or d2, and pinning those
//   needs ln(F/K) — which is the same exp gadget run backwards (L is the log of F/K iff
//   K*exp(L) = F), so it is another instance of this block and not a new problem. NOT BUILT HERE.
//   What IS measured in gateB7-5: n and p together over-determine x, so a caller who binds p to a
//   published gamma and n to a published delta pins x without any logarithm at all.
//
// ── THE TAIL ──
//   Hart switches to a continued fraction at z = 7.0711. This circuit does NOT carry that branch.
//   Above the split it proves a BOUND instead: the upper tail is under 2 / 2^24, and the
//   density under 2 / 2^24. That is a real weakening and it is published as `computed`, so a
//   reader can see which of the two statements they were given. Measured over a listed-book shape,
//   1.03% of legs land there; over a one-hour-to-one-week wing, 46.79% do.
//
// ── SCALE ── every quantity is an integer at 2^-24. The truncating multiply
//   out * 2^S + rem = a * b,  0 <= rem < 2^S
//   is one constraint plus an S-bit range check, and it is the dominant cost: 26 of them.

include "../../node_modules/circomlib/circuits/bitify.circom";
include "../../node_modules/circomlib/circuits/comparators.circom";
include "../../node_modules/circomlib/circuits/mux4.circom";

// a * b >> S, with the discarded remainder range-checked so the prover cannot pick a rounding.
// Without the range check `out` is unconstrained below the S-th bit and the whole evaluator is
// decoration — the same failure the mantissa lower bound in greeksfp existed to prevent.
template MulShift(S) {
    signal input a;
    signal input b;
    signal output out;
    signal rem;
    signal prod;
    prod <== a * b;
    out <-- prod \ (1 << S);
    rem <-- prod % (1 << S);
    prod === out * (1 << S) + rem;
    component rb = Num2Bits(S);
    rb.in <== rem;
}

template NormalCdf() {
    var S      = 24;
    var ONE    = 16777216;                 // 1.0
    var NB_X   = 36;
    var NB_R   = 69;                       // derived: max(cHat*dHat, eHat*bHat) + 2, not rounded up
    var NB_P   = 52;
    var TOLC   = 12;                        // ulp; derived, see the block at the c relation
    var TOLP   = 10;
    var ZSPLIT = 118632832;      // 7.07106781186547, where Hart changes branch
    var SQRT2PI = 42054243;     // computed by Machin + integer sqrt, not quoted from a table
    var CDF_TAIL = 2;                   // N(-7.0711), the tail bound
    var PHI_TAIL = 2;                  // phi(7.0711), the density bound

    // ---- public interface -----------------------------------------------------------------
    signal input xSign;      // 0 when x >= 0, 1 when x < 0
    signal input xMag;       // |x| * 2^S
    signal input nHat;       // the claimed N(x) * 2^S
    signal input pHat;       // the claimed density phi(x) * 2^S

    signal output computed;  // 1 when the CDF was evaluated, 0 when only the tail bound was proven
    signal output tailC;     // the bound in force above the split, published so it is not implied
    signal output tailP;
    tailC <== CDF_TAIL;
    tailP <== PHI_TAIL;

    xSign * (xSign - 1) === 0;
    component rx = Num2Bits(NB_X);   rx.in <== xMag;
    component rn = Num2Bits(S + 1);  rn.in <== nHat;      // N is in [0,1], so S+1 bits is exact
    component rp = Num2Bits(S);      rp.in <== pHat;      // phi <= 0.3990 < 1
    component nLe = LessEqThan(S + 2); nLe.in[0] <== nHat; nLe.in[1] <== ONE; nLe.out === 1;

    // ---- which branch -------------------------------------------------------------------
    component split = LessThan(NB_X + 1);
    split.in[0] <== xMag;
    split.in[1] <== ZSPLIT;
    computed <== split.out;

