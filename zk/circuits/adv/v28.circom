    mx[3].s[0] <== wbits.out[12];
    mx[3].s[1] <== wbits.out[13];
    mx[3].s[2] <== wbits.out[14];
    mx[3].s[3] <== wbits.out[15];
    em[3] = MulShift(S);   em[3].a <== acc[3];   em[3].b <== mx[3].out;   acc[4] <== em[3].out;
    mx[4] = Mux4();
    mx[4].c[0] <== 268435456;
    mx[4].c[1] <== 268369928;
    mx[4].c[2] <== 268304416;
    mx[4].c[3] <== 268238920;
    mx[4].c[4] <== 268173440;
    mx[4].c[5] <== 268107976;
    mx[4].c[6] <== 268042528;
    mx[4].c[7] <== 267977096;
    mx[4].c[8] <== 267911680;
    mx[4].c[9] <== 267846280;
    mx[4].c[10] <== 267780895;
    mx[4].c[11] <== 267715527;
    mx[4].c[12] <== 267650175;
    mx[4].c[13] <== 267584839;
    mx[4].c[14] <== 267519518;
    mx[4].c[15] <== 267454214;
    mx[4].s[0] <== wbits.out[16];
    mx[4].s[1] <== wbits.out[17];
    mx[4].s[2] <== wbits.out[18];
    mx[4].s[3] <== wbits.out[19];
    em[4] = MulShift(S);   em[4].a <== acc[4];   em[4].b <== mx[4].out;   acc[5] <== em[4].out;
    mx[5] = Mux4();
    mx[5].c[0] <== 268435456;
    mx[5].c[1] <== 267388925;
    mx[5].c[2] <== 266346475;
    mx[5].c[3] <== 265308088;
    mx[5].c[4] <== 264273750;
    mx[5].c[5] <== 263243444;
    mx[5].c[6] <== 262217155;
    mx[5].c[7] <== 261194868;
    mx[5].c[8] <== 260176565;
    mx[5].c[9] <== 259162233;
    mx[5].c[10] <== 258151855;
    mx[5].c[11] <== 257145416;
    mx[5].c[12] <== 256142901;
    mx[5].c[13] <== 255144295;
    mx[5].c[14] <== 254149582;
    mx[5].c[15] <== 253158746;
    mx[5].s[0] <== wbits.out[20];
    mx[5].s[1] <== wbits.out[21];
    mx[5].s[2] <== wbits.out[22];
    mx[5].s[3] <== wbits.out[23];
    em[5] = MulShift(S);   em[5].a <== acc[5];   em[5].b <== mx[5].out;   acc[6] <== em[5].out;
    mx[6] = Mux4();
    mx[6].c[0] <== 268435456;
    mx[6].c[1] <== 252171774;
    mx[6].c[2] <== 236893458;
    mx[6].c[3] <== 222540809;
    mx[6].c[4] <== 209057743;
    mx[6].c[5] <== 196391575;
    mx[6].c[6] <== 184492811;
    mx[6].c[7] <== 173314957;
    mx[6].c[8] <== 162814334;
    mx[6].c[9] <== 152949912;
    mx[6].c[10] <== 143683146;
    mx[6].c[11] <== 134977824;
    mx[6].c[12] <== 126799931;
    mx[6].c[13] <== 119117512;
    mx[6].c[14] <== 111900546;
    mx[6].c[15] <== 105120835;
    mx[6].s[0] <== wbits.out[24];
    mx[6].s[1] <== wbits.out[25];
    mx[6].s[2] <== wbits.out[26];
    mx[6].s[3] <== wbits.out[27];
    em[6] = MulShift(S);   em[6].a <== acc[6];   em[6].b <== mx[6].out;   acc[7] <== em[6].out;
    mx[7] = Mux4();
    mx[7].c[0] <== 268435456;
    mx[7].c[1] <== 98751886;
    mx[7].c[2] <== 36328788;
    mx[7].c[3] <== 13364614;
    mx[7].c[4] <== 4916567;
    mx[7].c[5] <== 1808704;
    mx[7].c[6] <== 665385;
    mx[7].c[7] <== 244781;
    mx[7].c[8] <== 90050;
