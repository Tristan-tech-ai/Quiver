    wRem <-- sq % (1 << 29);
    sq === W * (1 << 29) + wRem;
    component wrb = Num2Bits(29);  wrb.in <== wRem;
    component wbits = Num2Bits(33);  wbits.in <== W;

    // ---- e^{-W}: 9 groups of 4 bits, one Mux4 and one MulShift each -------------------------
    // 144 constants, generated at 200 fractional bits and re-derived by the gate.
    component mx[9];
    component em[9];
    signal acc[10];
    acc[0] <== ONE;
    mx[0] = Mux4();
    mx[0].c[0] <== 268435456;
    mx[0].c[1] <== 268435455;
    mx[0].c[2] <== 268435454;
    mx[0].c[3] <== 268435453;
    mx[0].c[4] <== 268435452;
    mx[0].c[5] <== 268435451;
    mx[0].c[6] <== 268435450;
    mx[0].c[7] <== 268435449;
    mx[0].c[8] <== 268435448;
    mx[0].c[9] <== 268435447;
    mx[0].c[10] <== 268435446;
    mx[0].c[11] <== 268435445;
    mx[0].c[12] <== 268435444;
    mx[0].c[13] <== 268435443;
    mx[0].c[14] <== 268435442;
    mx[0].c[15] <== 268435441;
    mx[0].s[0] <== wbits.out[0];
    mx[0].s[1] <== wbits.out[1];
    mx[0].s[2] <== wbits.out[2];
    mx[0].s[3] <== wbits.out[3];
    em[0] = MulShift(S);   em[0].a <== acc[0];   em[0].b <== mx[0].out;   acc[1] <== em[0].out;
    mx[1] = Mux4();
    mx[1].c[0] <== 268435456;
    mx[1].c[1] <== 268435440;
    mx[1].c[2] <== 268435424;
    mx[1].c[3] <== 268435408;
    mx[1].c[4] <== 268435392;
    mx[1].c[5] <== 268435376;
    mx[1].c[6] <== 268435360;
    mx[1].c[7] <== 268435344;
    mx[1].c[8] <== 268435328;
    mx[1].c[9] <== 268435312;
    mx[1].c[10] <== 268435296;
    mx[1].c[11] <== 268435280;
    mx[1].c[12] <== 268435264;
    mx[1].c[13] <== 268435248;
    mx[1].c[14] <== 268435232;
    mx[1].c[15] <== 268435216;
    mx[1].s[0] <== wbits.out[4];
    mx[1].s[1] <== wbits.out[5];
    mx[1].s[2] <== wbits.out[6];
    mx[1].s[3] <== wbits.out[7];
    em[1] = MulShift(S);   em[1].a <== acc[1];   em[1].b <== mx[1].out;   acc[2] <== em[1].out;
    mx[2] = Mux4();
    mx[2].c[0] <== 268435456;
    mx[2].c[1] <== 268435200;
    mx[2].c[2] <== 268434944;
    mx[2].c[3] <== 268434688;
    mx[2].c[4] <== 268434432;
    mx[2].c[5] <== 268434176;
    mx[2].c[6] <== 268433920;
    mx[2].c[7] <== 268433664;
    mx[2].c[8] <== 268433408;
    mx[2].c[9] <== 268433152;
    mx[2].c[10] <== 268432896;
    mx[2].c[11] <== 268432640;
    mx[2].c[12] <== 268432384;
    mx[2].c[13] <== 268432128;
    mx[2].c[14] <== 268431872;
    mx[2].c[15] <== 268431616;
    mx[2].s[0] <== wbits.out[8];
    mx[2].s[1] <== wbits.out[9];
    mx[2].s[2] <== wbits.out[10];
    mx[2].s[3] <== wbits.out[11];
    em[2] = MulShift(S);   em[2].a <== acc[2];   em[2].b <== mx[2].out;   acc[3] <== em[2].out;
    mx[3] = Mux4();
    mx[3].c[0] <== 268435456;
    mx[3].c[1] <== 268431360;
    mx[3].c[2] <== 268427264;
    mx[3].c[3] <== 268423168;
    mx[3].c[4] <== 268419072;
    mx[3].c[5] <== 268414977;
    mx[3].c[6] <== 268410881;
