    mx[3].c[8] <== 268402690;
    mx[3].c[9] <== 268398595;
    mx[3].c[10] <== 268394499;
    mx[3].c[11] <== 268390404;
    mx[3].c[12] <== 268386308;
    mx[3].c[13] <== 268382213;
